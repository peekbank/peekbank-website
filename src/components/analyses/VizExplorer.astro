---
// Mounts one Quarto-built explorer into the astro page
// Fragments are generated from viz_src/ by scripts/build-viz.mjs
import fs from "node:fs";
import { createHash } from "node:crypto";
import explorers from "../../../viz_src/explorers.js";

interface Props {
  slug: string;
}
const { slug } = Astro.props;

const fragments = import.meta.glob("./viz_autogen/*.fragment.html", {
  query: "?raw",
  import: "default",
  eager: true,
});
const fragment = fragments[`./viz_autogen/${slug}.fragment.html`];
if (!fragment && import.meta.env.PROD) {
  throw new Error(`No viz fragment for "${slug}" — run: npm run build:viz`);
}

// Astro does not normalise this, so we do
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";
const vizBase = `${base}viz/`;

const dataBase = process.env.PEEKBANK_SLICES_BASE || `${vizBase}slices/`;

// public/viz/ keeps the same file names across deploys, and GitHub Pages lets
// browsers reuse a copy for ten minutes, which can pair new markup with an
// old stylesheet. A hash of the contents in the URL makes them fetch the new
// file as soon as it changes.
const asset = (file: string) => {
  const path = `public/viz/${file}`;
  if (!fs.existsSync(path)) return `${vizBase}${file}`;
  const hash = createHash("sha256").update(fs.readFileSync(path)).digest("hex").slice(0, 8);
  return `${vizBase}${file}?v=${hash}`;
};
---

{/* scoped bootstrap + our overrides, both generated by build-viz.mjs. Ahead
    of the markup, so the browser holds the explorer back until they load
    instead of painting it unstyled first. */}
<link rel="stylesheet" href={asset("viz.css")} />
<link rel="stylesheet" href={asset("quarto-ojs.css")} />

{/* same width and centring as the explorer below (.pb-viz in viz-embed.css) */}
<nav class="mx-auto flex max-w-[1400px] flex-wrap gap-[0.4rem] px-6 py-4">
  {
    explorers.map((e) => (
      <a
        href={`${base}analyses/${e.slug}/`}
        class="rounded-[10px] bg-[#eef2f6] px-3.5 py-1 text-[0.85rem] text-[#1f2937] no-underline hover:bg-blue-100 aria-[current=page]:bg-[#1f2937] aria-[current=page]:text-white"
        aria-current={e.slug === slug ? "page" : undefined}
      >
        {e.label}
      </a>
    ))
  }
</nav>

{
  fragment ? (
    <Fragment set:html={fragment} />
  ) : (
    <div class="mx-6 my-8 rounded-lg border border-dashed border-gray-300 px-5 py-4 text-gray-600">
      <p class="mt-0 mb-1">
        <strong>The {slug} explorer has not been built.</strong>
      </p>
      <p class="my-1">
        Run <code>npm run build:viz</code> (requires Quarto) to generate it.
      </p>
    </div>
  )
}


{/* Bootstrap's JS to match quarto output.*/}
<script is:inline src={asset("bootstrap.min.js")}></script>

{/* the explorers read this before fetching data; must precede the runtime */}
<script is:inline define:vars={{ dataBase }}>
  window.PEEKBANK_DATA_BASE = dataBase;
</script>

<script is:inline type="module" src={asset("quarto-ojs-runtime.js")}></script>
<script is:inline type="module">
  // This scans the document for
  // <script type="ojs-module-contents">, decodes the base64 cell sources and
  // mounts each into its ojs-cell-* anchor. Quarto itself
  // makes the call in its own page tail, but since we only extracted the <main></main> part, so we need to do this here.
  if (window._ojs) window._ojs.runtime.interpretFromScriptTags();
</script>

<style is:global>
  /* Global so we dont get prefixed by astro */
  /* Starlight's splash template still renders the frontmatter title; each
     explorer opens with its own heading, so this would be a duplicate. */
  .content-panel:first-of-type { display: none !important; }
  /* .content-panel + .content-panel draws a 1px hairline above the viz, and
     .content-panel adds 1.5rem padding on top of .pb-viz's own. */
  .content-panel { border: none !important; padding: 0; }
  /* Starlight caps content at a prose column (1080px here); the sidebar +
     plot grid needs the viewport, up to .pb-viz's own 1400px cap. */
  .sl-container { max-width: 100%; }
</style>
