---
// Band of stimulus images, scrolling sideways.
import { Image } from "astro:assets";
import baby from "/src/assets/stimuli/Baby.png";
import ball from "/src/assets/stimuli/Ball.png";
import banana from "/src/assets/stimuli/Banana.png";
import birdy from "/src/assets/stimuli/Birdy.png";
import book from "/src/assets/stimuli/Book.png";
import car from "/src/assets/stimuli/Car.png";
import cookie from "/src/assets/stimuli/Cookie.png";
import juice from "/src/assets/stimuli/Juice.png";
import kitty from "/src/assets/stimuli/Kitty.png";
import shoe from "/src/assets/stimuli/Shoe.png";
import doggy from "/src/assets/stimuli/doggy.png";

const { class: className } = Astro.props;

const stimuli = [book, ball, car, baby, doggy, shoe, kitty, birdy, juice, cookie, banana];
const track = [...stimuli, ...stimuli];
---

<div class:list={["marquee overflow-hidden", className]} aria-hidden="true">
  <div class="marquee__track flex w-max items-center">
    {track.map((src) => <Image src={src} width={64} densities={[1, 2, 3]} loading="eager" alt="" class="mr-8 h-16 w-auto object-contain" />)}
  </div>
</div>

<style>
  .marquee {
    /* Softens both ends so images do not cut off hard at the screen edge. */
    mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
  }

  .marquee__track {
    animation: marquee-scroll 40s linear infinite;
    will-change: transform;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>
