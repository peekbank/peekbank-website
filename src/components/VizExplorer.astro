---
// Mounts one Quarto-built explorer into the astro page
// Fragments are generated from viz_src/ by scripts/build-viz.mjs
import "../../viz_src/viz-embed.css";
import explorers from "../../viz_src/explorers.js";

interface Props {
  slug: string;
}
const { slug } = Astro.props;


const fragments = import.meta.glob("./viz_autogen/*.fragment.html", {
  query: "?raw",
  import: "default",
  eager: true,
});
const fragment = fragments[`./viz_autogen/${slug}.fragment.html`];
if (!fragment && import.meta.env.PROD) {
  throw new Error(`No viz fragment for "${slug}" — run: npm run build:viz`);
}

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";
const vizBase = `${base}viz/`;

const dataBase = process.env.PEEKBANK_SLICES_BASE || `${vizBase}slices/`;
---

<nav class="flex flex-wrap gap-[0.4rem] px-6 py-4">
  {
    explorers.map((e) => (
      <a
        href={`${base}analyses/${e.slug}/`}
        class="rounded-[10px] bg-[#eef2f6] px-3.5 py-1 text-[0.85rem] text-[#1f2937] no-underline hover:bg-blue-100 aria-[current=page]:bg-[#1f2937] aria-[current=page]:text-white"
        aria-current={e.slug === slug ? "page" : undefined}
      >
        {e.label}
      </a>
    ))
  }
</nav>

{
  fragment ? (
    <Fragment set:html={fragment} />
  ) : (
    <div class="mx-6 my-8 rounded-lg border border-dashed border-gray-300 px-5 py-4 text-gray-600">
      <p class="mt-0 mb-1">
        <strong>The {slug} explorer has not been built.</strong>
      </p>
      <p class="my-1">
        Run <code>npm run build:viz</code> (requires Quarto) to generate it.
      </p>
    </div>
  )
}

<link rel="stylesheet" href={`${vizBase}quarto-ojs.css`} />

{/* the explorers read this before fetching data; must precede the runtime */}
<script is:inline define:vars={{ dataBase }}>
  window.PEEKBANK_DATA_BASE = dataBase;
</script>

<script is:inline type="module" src={`${vizBase}quarto-ojs-runtime.js`}></script>
<script is:inline type="module">
  if (window._ojs) {
    // The startup snippet Quarto emits in its own page HTML.
    // We harvest only <main> + the cell sources, so this is left behind and we re-emit it..
    window._ojs.paths.runtimeToDoc = "../..";
    window._ojs.paths.runtimeToRoot = "../..";
    window._ojs.paths.docToRoot = "";
    window._ojs.selfContained = false;
    window._ojs.runtime.interpretFromScriptTags();
  }

  // minimal replacement for bootstrap's Tab plugin, will be deleted once we ship an isolated version of bootstrap
  document.addEventListener("click", (ev) => {
    const tab = ev.target.closest('.pb-viz [data-bs-toggle="tab"]');
    if (!tab) return;
    ev.preventDefault();
    const tabset = tab.closest(".panel-tabset");
    for (const t of tabset.querySelectorAll('[data-bs-toggle="tab"]')) {
      t.classList.toggle("active", t === tab);
      t.setAttribute("aria-selected", t === tab ? "true" : "false");
    }
    const target = tabset.querySelector(tab.dataset.bsTarget);
    for (const pane of tabset.querySelectorAll(".tab-pane")) {
      pane.classList.toggle("active", pane === target);
      pane.classList.toggle("show", pane === target);
    }
  });
</script>

<style is:global>
  /* Global so we dont get prefixed */
  /* Starlight's splash template still renders the frontmatter title; each
     explorer opens with its own heading, so this would be a duplicate. */
  .content-panel:first-of-type { display: none !important; }
  /* .content-panel + .content-panel draws a 1px hairline above the viz, and
     .content-panel adds 1.5rem padding on top of .pb-viz's own. */
  .content-panel { border: none !important; padding: 0; }
  /* Starlight caps content at a prose column (1080px here); the sidebar +
     plot grid needs the viewport, up to .pb-viz's own 1400px cap. */
  .sl-container { max-width: 100%; }
</style>
