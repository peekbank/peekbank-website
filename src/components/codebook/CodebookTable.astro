---
import current from "../../data/codebook.json";
import schema2021 from "../../data/codebook-2021.json";

interface Props {
  table: string;
  schema?: "2021";
}

const { table, schema } = Astro.props;
const codebook = schema === "2021" ? schema2021 : current;
const entry = codebook.find((t) => t.table === table);
if (!entry) throw new Error(`No codebook entry for table "${table}"`);

// Beyond this many, an enum is folded away rather than printed in full —
// full_phrase_language alone accepts 489 ISO codes.
const INLINE_VALUES = 12;

const segments = (text: string) => text.split(/(https?:\/\/[^\s;,)]+)/g);

const th = "p-0 text-left font-medium text-ink";
const td = "block p-0 align-top md:table-cell";
// The rules sit on an inner div so the column padding leaves a gap in them.
const cell = "border-t border-black/10 py-3";
---

<div class="not-content mt-4 text-sm">
  <table class="block w-full border-collapse md:table md:table-fixed">
    <thead class="hidden md:table-header-group">
      <tr>
        <th class={`${th} w-[14.5rem] pr-6`}>Field</th>
        <th class={`${th} w-[8.5rem] pr-6`}>Type</th>
        <th class={th}>Description</th>
      </tr>
    </thead>

    <tbody class="block md:table-row-group">
      {
        entry.fields.map((field) => (
          <tr class="block md:table-row">
            <td class={`${td} md:pr-6`}>
              <div id={schema ? undefined : `${table}-${field.name}`} class={`${cell} pb-1 md:pb-3`}>
                <code class="font-mono text-[0.85em] break-words text-ink">{field.name}</code>
                {field.key === "primary" && <span class="ml-1 whitespace-nowrap rounded border border-black/15 px-1 py-px text-xs text-brown">key</span>}
                {field.references && (
                  <span class="ml-1 whitespace-nowrap rounded border border-black/15 px-1 py-px text-xs text-brown">→ {field.references}</span>
                )}
              </div>
            </td>

            <td class={`${td} md:pr-6`}>
              <div class={`${cell} border-t-0 py-0 text-xs text-brown md:border-t md:py-3 md:text-sm`}>
                {field.type}
                {!field.required && <span class="text-gray-400"> · optional</span>}
              </div>
            </td>

            <td class={td}>
              <div class={`${cell} border-t-0 pt-1 break-words md:border-t md:pt-3`}>
                {segments(field.description).map((part) =>
                  /^https?:\/\//.test(part) ? (
                    <a href={part} target="_blank" class="break-all">
                      {part}
                    </a>
                  ) : (
                    part
                  ),
                )}

                {field.values.length > 0 && field.values.length <= INLINE_VALUES && (
                  <>
                    {/* one line, since Astro renders the line breaks between elements as spaces */}
                    {" "}One of {field.values.map((v, i) => <>{i > 0 && ", "}<code class="font-mono text-[0.85em]">{v}</code></>)}.
                  </>
                )}

                {field.values.length > INLINE_VALUES && (
                  <details class="mt-2" data-mdast="ignore">
                    <summary class="cursor-pointer text-xs text-brown">
                      {field.values.length} accepted values
                    </summary>
                    <p class="mt-1 font-mono text-xs break-words text-brown">
                      {field.values.join(", ")}
                    </p>
                  </details>
                )}
              </div>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
