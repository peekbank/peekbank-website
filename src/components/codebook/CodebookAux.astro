---
import aux from "../../data/codebook-aux.json";

const td = "block p-0 align-top md:table-cell";
// The rules sit on an inner div so the column padding leaves a gap in them.
const cell = "border-t border-black/10 py-3";
---

{
  aux.map((group) => (
    <>
      <h3 id={group.column}>{group.column}</h3>

      <div class="not-content mt-4 text-sm">
        <table class="block w-full border-collapse md:table md:table-fixed">
          {/* only for llms-full.txt, where a table needs a header row */}
          <thead class="hidden">
            <tr>
              <th>Field</th>
              <th>Type</th>
              <th>Description</th>
            </tr>
          </thead>

          <tbody class="block md:table-row-group">
            {group.entries.map((entry) => (
              <>
                <tr class="block md:table-row">
                  <td class={`${td} md:w-[14.5rem] md:pr-6`}>
                    <div class={`${cell} pb-1 md:pb-3`}>
                      <code class="font-mono text-[0.85em] break-words text-ink">{entry.name}</code>
                    </div>
                  </td>

                  <td class={`${td} md:w-[8.5rem] md:pr-6`}>
                    <div class={`${cell} border-t-0 py-0 text-xs text-brown md:border-t md:py-3 md:text-sm`}>
                      {entry.type}
                      {!entry.required && <span class="text-gray-400"> · optional</span>}
                    </div>
                  </td>

                  <td class={td}>
                    <div class={`${cell} border-t-0 pt-1 break-words md:border-t md:pt-3`}>
                      {entry.description}
                    </div>
                  </td>
                </tr>

                {entry.children.map((child) => (
                  <tr class="block md:table-row">
                    <td class={`${td} md:pr-6`}>
                      <div class="pl-4 pb-1 md:pb-2">
                        {/* the parent's name is only for llms-full.txt, which loses the indent */}
                        <code class="font-mono text-[0.85em] break-words text-brown"><span class="hidden">{entry.name}.</span>{child.name}</code>
                      </div>
                    </td>

                    <td class={`${td} md:pr-6`}>
                      <div class="py-0 text-xs text-brown md:py-2">
                        {child.type}
                        {!child.required && <span class="text-gray-400"> · optional</span>}
                      </div>
                    </td>

                    <td class={td}>
                      <div class="pt-1 pb-2 break-words text-brown md:pt-0 md:pb-2">
                        {child.description}
                      </div>
                    </td>
                  </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ))
}
