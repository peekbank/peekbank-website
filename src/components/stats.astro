---
import { datasets, total, languageCount, fmt } from "../lib/manifest";

const stats = [
  { value: datasets.length, label: "Datasets" },
  { value: total("n_subjects"), label: "Children" },
  { value: total("n_trials"), label: "Trials" },
  { value: languageCount, label: "Languages" },
];
---

<div class="grid grid-cols-2 gap-x-8 gap-y-10">
  {
    stats.map((stat) => (
      <div class="flex flex-col gap-1">
        <div class="font-librebask text-4xl font-bold tracking-tight tabular-nums text-ink">
          {fmt(stat.value)}
        </div>
        <div class="text-sm text-brown">{stat.label}</div>
      </div>
    ))
  }
</div>
