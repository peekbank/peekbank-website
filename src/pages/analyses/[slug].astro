---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import VizExplorer from "../../components/VizExplorer.astro";
import explorers from "../../../viz_src/explorers.js";

export function getStaticPaths() {
  return explorers.map((e) => ({ params: { slug: e.slug }, props: e }));
}

const { slug, title } = Astro.props;
---

<StarlightPage frontmatter={{ title, template: "splash" }}>
  <VizExplorer slug={slug} />
</StarlightPage>
