# Rename (or copy) this file to .env.local and fill in your own token.
# .env.local is gitignored; this template is not, so never put a real
# token here.
#
# You need a read-only Redivis token with the data.metadata scope, which is
# required for queries on any data. `npm run viz:pull` uses it to
# fetch the data slices for the release pinned in viz_src/release.json.
REDIVIS_API_TOKEN=
