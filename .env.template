# Rename (or copy) this file to .env.local and fill in your own token.
# .env.local is gitignored; this template is not, so never put a real
# token here.
#
# A read-only Redivis token is enough. `npm run viz:pull` uses it to fetch
# the data slices for the release pinned in viz_src/release.json.
REDIVIS_API_TOKEN=
